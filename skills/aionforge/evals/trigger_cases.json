{
  "version": 3,
  "description": "AionForge Skill 触发回归评测集：验证印花准备、实拍调色合成、模特主图、详情图与过滤非出图请求。",
  "cases": [
    {
      "id": "trigger-print-extract",
      "user_prompt": "帮我把这件黑色 T 恤胸前的胶印图案抠出来，要透明底 PNG",
      "should_trigger": true,
      "expected_workflow": "print"
    },
    {
      "id": "trigger-print-front-back",
      "user_prompt": "这批印花里哪些适合印在 T 恤正面，哪些适合印在背面？",
      "should_trigger": true,
      "expected_workflow": "print"
    },
    {
      "id": "trigger-print-back-badge",
      "user_prompt": "后背印大图，左胸前再加一个小印花，通过印花图案提取核心元素",
      "should_trigger": true,
      "expected_workflow": "print"
    },
    {
      "id": "trigger-product-color-conflict",
      "user_prompt": "把这个印花合成在黑色 T 恤实拍图上，存在颜色冲突帮我调整适配一下印花颜色",
      "should_trigger": true,
      "expected_workflow": "product"
    },
    {
      "id": "trigger-product-compose",
      "user_prompt": "把提取好的小熊图案印到这件米白色纯色 T 恤实拍图胸口正中央",
      "should_trigger": true,
      "expected_workflow": "product"
    },
    {
      "id": "trigger-product-all-colors",
      "user_prompt": "这件 T 恤有黑、白、藏青三个颜色实拍，每个颜色都合成正反面商品图",
      "should_trigger": true,
      "expected_workflow": "product"
    },
    {
      "id": "trigger-product-back-photo",
      "user_prompt": "把背面主印花合成到这件 T 恤的背面实拍图上",
      "should_trigger": true,
      "expected_workflow": "product"
    },
    {
      "id": "trigger-main-tryon-model",
      "user_prompt": "把合成好的这件印花 T 恤穿到这个模特身上生成主图，保留模特的脸和眼神",
      "should_trigger": true,
      "expected_workflow": "main"
    },
    {
      "id": "trigger-main-vary-angles",
      "user_prompt": "根据这张模特主图，保持同一个房间和模特，再生成正面和背面回眸几个姿势主图",
      "should_trigger": true,
      "expected_workflow": "main"
    },
    {
      "id": "trigger-detail-infographic",
      "user_prompt": "根据生成的主图和 T 恤商品图，帮我生成一套带卖点放大和正反对比的详情图",
      "should_trigger": true,
      "expected_workflow": "detail"
    },
    {
      "id": "no-trigger-code-debug",
      "user_prompt": "帮我看看 aionforge 的 catalog.py 为什么报 KeyError，顺便重构一下测试",
      "should_trigger": false,
      "expected_workflow": null
    },
    {
      "id": "no-trigger-ecom-operation",
      "user_prompt": "拼多多直通车 ROI 怎么算？前期怎么测款出价？",
      "should_trigger": false,
      "expected_workflow": null
    }
  ]
}
