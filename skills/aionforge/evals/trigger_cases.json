{
  "version": 2,
  "description": "AionForge Skill 触发回归评测集：验证核心电商出图意图命中与非出图请求过滤。",
  "cases": [
    {
      "id": "trigger-white-extract-print",
      "user_prompt": "帮我把这件黑色卫衣胸前的胶印图案抠出来，要透明底 PNG",
      "should_trigger": true,
      "expected_workflow": "white"
    },
    {
      "id": "trigger-white-compose-print",
      "user_prompt": "把这个提取好的小熊图案印到这件米白色纯色 T 恤胸口正中央，出白底图",
      "should_trigger": true,
      "expected_workflow": "white"
    },
    {
      "id": "trigger-white-all-colors",
      "user_prompt": "这件卫衣有黑、白、藏青三个颜色，每个颜色都合成一张白底衣图",
      "should_trigger": true,
      "expected_workflow": "white"
    },
    {
      "id": "trigger-main-tryon-model",
      "user_prompt": "把这件法式方领碎花连衣裙穿到这个模特身上，保留模特的脸和眼神",
      "should_trigger": true,
      "expected_workflow": "main"
    },
    {
      "id": "trigger-main-vary-angles",
      "user_prompt": "这张换装成片很不错，保持同一个房间和模特，再给我裂变 6 个不同机位和姿势",
      "should_trigger": true,
      "expected_workflow": "main"
    },
    {
      "id": "trigger-sku-colorways",
      "user_prompt": "这张主图当 SKU 母版，按黑、藏青、浅灰三张白底成衣出批量规格图",
      "should_trigger": true,
      "expected_workflow": "sku"
    },
    {
      "id": "trigger-detail-infographic",
      "user_prompt": "这件针织开衫上架拼多多，帮我出 3 张带卖点放大的详情图",
      "should_trigger": true,
      "expected_workflow": "detail"
    },
    {
      "id": "no-trigger-code-debug",
      "user_prompt": "帮我看看 aionforge 的 catalog.py 为什么报 KeyError，顺便重构一下测试",
      "should_trigger": false,
      "expected_workflow": null
    },
    {
      "id": "no-trigger-ecom-operation",
      "user_prompt": "拼多多女装直通车 ROI 怎么算？前期怎么测款出价？",
      "should_trigger": false,
      "expected_workflow": null
    }
  ]
}
