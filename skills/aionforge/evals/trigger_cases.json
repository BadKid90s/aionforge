{
  "version": 1,
  "description": "AionForge Skill 触发回归评测集：验证六大核心电商出图意图命中与非出图请求过滤。",
  "cases": [
    {
      "id": "trigger-extract-print",
      "user_prompt": "帮我把这件黑色卫衣胸前的胶印图案抠出来，要透明底 PNG",
      "should_trigger": true,
      "expected_workflow": "extract"
    },
    {
      "id": "trigger-compose-print",
      "user_prompt": "把这个提取好的小熊图案印到这件米白色纯色 T 恤胸口正中央",
      "should_trigger": true,
      "expected_workflow": "compose"
    },
    {
      "id": "trigger-tryon-model",
      "user_prompt": "把这件法式方领碎花连衣裙穿到这个模特身上，保留模特的脸和眼神",
      "should_trigger": true,
      "expected_workflow": "tryon"
    },
    {
      "id": "trigger-vary-angles",
      "user_prompt": "这张换装成片很不错，保持同一个房间和模特，再给我裂变 6 个不同机位和姿势",
      "should_trigger": true,
      "expected_workflow": "vary"
    },
    {
      "id": "trigger-pdp-suite",
      "user_prompt": "这件针织开衫我要上架拼多多，帮我出一套高转化主图和带卖点放大的详情页套图",
      "should_trigger": true,
      "expected_workflow": "pdp"
    },
    {
      "id": "trigger-deconstruct-competitor",
      "user_prompt": "参考这张竞品爆款主图的版式构图和暖调光影，换成我自己的白底醋酸半身裙出一组图",
      "should_trigger": true,
      "expected_workflow": "deconstruct"
    },
    {
      "id": "no-trigger-code-debug",
      "user_prompt": "帮我看看 aionforge 的 catalog.py 为什么报 KeyError，顺便重构一下测试",
      "should_trigger": false,
      "expected_workflow": null
    },
    {
      "id": "no-trigger-ecom-operation",
      "user_prompt": "拼多多女装直通车 ROI 怎么算？前期怎么测款出价？",
      "should_trigger": false,
      "expected_workflow": null
    }
  ]
}
