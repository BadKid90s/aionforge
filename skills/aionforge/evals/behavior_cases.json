{
  "version": 3,
  "description": "AionForge Skill 行为契约回归评测集：验证「思考-事实锁定-生成-检查」闭环、工具与流程分离、正反面左胸联动与撞色适配。",
  "cases": [
    {
      "id": "behavior-no-image-index-reference",
      "scenario": "多参考图输入（bg_white 成衣图 + 模特图 + 姿势参考图）编写 Prompt",
      "must_include": [
        "成衣图",
        "模特图"
      ],
      "must_not_include": [
        "图1",
        "图2",
        "第一张图",
        "第二张图"
      ]
    },
    {
      "id": "behavior-logo-is-design-not-watermark",
      "scenario": "素材 logo/1.jpg 这类带素材站水印的图案稿，需要推断 logo 名并合成",
      "must_include": [
        "图案",
        "主标题",
        "水印"
      ],
      "must_not_include": [
        "千图网"
      ]
    },
    {
      "id": "behavior-bg-white-canonical",
      "scenario": "完成 T 恤实拍合成后继续出 main 主图与 detail 详情图",
      "must_include": [
        "bg_white",
        "canonical.garment",
        "唯一真相源"
      ],
      "must_not_include": [
        "直接拿模特原衣",
        "用原始成衣图当 main 的 garment"
      ]
    },
    {
      "id": "behavior-two-stage-model-anchor",
      "scenario": "main 包含多张同模特主图与多姿势展示图",
      "must_include": [
        "hero",
        "source",
        "bg_white"
      ],
      "must_not_include": []
    },
    {
      "id": "behavior-all-colors-default",
      "scenario": "用户给了多个颜色的 T 恤实拍图，但没有说只出主色",
      "must_include": [
        "所有颜色",
        "colors[]"
      ],
      "must_not_include": [
        "只出主色",
        "默认只出一个颜色"
      ]
    },
    {
      "id": "behavior-detail-uses-main-and-product",
      "scenario": "根据生成的模特主图和 T 恤商品图生成详情图",
      "must_include": [
        "source",
        "main",
        "bg_white"
      ],
      "must_not_include": [
        "只能用 bg_white 当 source"
      ]
    },
    {
      "id": "behavior-pinduoduo-modern-typography",
      "scenario": "拼多多卖点详情图排版",
      "must_include": [
        "#F7F5F2",
        "#EFECE6",
        "#2D2D2D",
        "#8C6A56",
        "VISIBLE_TEXT_BLOCK"
      ],
      "must_not_include": [
        "爆炸贴",
        "红底黄字",
        "粗黑描边",
        "#E02E24",
        "#FFD700"
      ]
    },
    {
      "id": "behavior-front-back-garment-routing",
      "scenario": "同时拥有正面成衣图与背面成衣图，生成背面展示主图或三角度详情图",
      "must_include": [
        "garment_back"
      ],
      "must_not_include": []
    },
    {
      "id": "behavior-back-print-requires-badge",
      "scenario": "主印花判断为背面印刷，需要在左胸前加核心元素小印花",
      "must_include": [
        "左胸",
        "核心图标",
        "背面"
      ],
      "must_not_include": [
        "整张印花缩小"
      ]
    },
    {
      "id": "behavior-print-color-contrast",
      "scenario": "深色 T 恤实拍图上的深色印花存在颜色冲突，需要做颜色调整适配",
      "must_include": [
        "对比度",
        "print adapt",
        "3:1"
      ],
      "must_not_include": [
        "重绘印花",
        "改字"
      ]
    },
    {
      "id": "behavior-back-photo-required",
      "scenario": "用户要背面印花，但没有提供背面 T 恤实拍",
      "must_include": [
        "背面实拍",
        "补图"
      ],
      "must_not_include": [
        "从正面推断背面",
        "镜像正面"
      ]
    },
    {
      "id": "behavior-tool-flow-separation-and-four-steps",
      "scenario": "工作流区分工具与流程，每个阶段遵循思考、事实锁定、生成、检查闭环",
      "must_include": [
        "思考",
        "事实锁定",
        "生成",
        "检查",
        "工具卡"
      ],
      "must_not_include": [
        "流程卡里写命令"
      ]
    }
  ]
}
