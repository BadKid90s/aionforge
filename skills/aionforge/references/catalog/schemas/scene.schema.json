{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionforge.local/schemas/scene.schema.json",
  "title": "拍摄场景目录",
  "description": "场景管房间/室外/棚，不管衣服和姿势。裂变默认锁参考图场景；用户要求换场景时按 keywords 选一条，把 prompt 写进该张图。",
  "type": "object",
  "required": ["version", "scenes"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["id", "name", "setting", "lighting", "background", "prompt"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": { "type": "string" },
        "setting": {
          "type": "string",
          "enum": ["studio", "indoor", "outdoor"],
          "description": "棚 / 室内 / 室外"
        },
        "lighting": { "type": "string", "description": "主光方向、软硬、色温" },
        "background": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "prompt": {
          "type": "string",
          "minLength": 12,
          "description": "写入出图 Prompt 的场景段落"
        },
        "avoid": {
          "type": "array",
          "items": { "type": "string" },
          "description": "不要出现的东西，如第二个人、杂乱道具"
        }
      }
    }
  }
}
