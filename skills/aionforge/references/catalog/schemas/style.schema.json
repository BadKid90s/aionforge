{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionforge.local/schemas/style.schema.json",
  "title": "视觉风格目录",
  "description": "风格管色板、冷暖、字体、留白、去 AI 质感和 Campaign Style Lock。选定后把 style_lock 原样贴进每一张 Prompt，不要每张重写。",
  "type": "object",
  "required": ["version", "styles"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/style" }
    }
  },
  "$defs": {
    "style": {
      "type": "object",
      "required": ["id", "name", "temperature", "palette", "style_lock"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": { "type": "string" },
        "platforms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "适用平台，如 pinduoduo、amazon"
        },
        "typography_id": {
          "type": "string",
          "description": "关联 typography.json 中的平台字体美学 id"
        },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "temperature": {
          "type": "string",
          "enum": ["warm", "cool", "neutral"],
          "description": "全套冷暖调"
        },
        "palette": {
          "type": "object",
          "required": ["background", "text"],
          "additionalProperties": false,
          "properties": {
            "background": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "主背景色，必须写 6 位 hex"
            },
            "background_alt": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "详情页交替副背景色，写 6 位 hex，防多屏视觉疲劳"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "图内文字色，必须写 6 位 hex"
            },
            "accent": {
              "type": "string",
              "description": "强调色 hex，或 product-matched 按成衣主色替换"
            }
          }
        },
        "lighting": { "type": "string" },
        "typography": { "type": "string" },
        "garment_scale": { "type": "string", "description": "服装占画面大致比例" },
        "whitespace": { "type": "string", "description": "显式留白比例要求，如 主图 ≥20%，信息图 ≥45%" },
        "anti_ai_tips": {
          "type": "string",
          "description": "去 AI 塑料感与真实摄影质感指令（种草/街拍/买家秀风格使用）"
        },
        "style_lock": {
          "type": "string",
          "minLength": 40,
          "description": "Campaign Style Lock 全文，原样复制到每张 Prompt"
        }
      }
    }
  }
}
