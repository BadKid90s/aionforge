{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionforge.local/schemas/poses.schema.json",
  "title": "女装机位与姿势目录",
  "description": "cameras 定义镜头，poses 定义身体，recipes 把二者合成一张可拍的成片，packs 是套餐。后期只追加对象，不要删已有 id。",
  "type": "object",
  "required": ["version", "cameras", "poses", "recipes", "packs"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "locale": { "type": "string" },
    "how_to_extend": { "type": "string" },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/camera" }
    },
    "poses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pose" }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/recipe" }
    },
    "packs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/pack" }
    },
    "substitutions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "kebab-case，文件内唯一"
    },
    "camera": {
      "type": "object",
      "required": ["id", "name", "height", "yaw", "framing", "prompt"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "height": { "type": "string", "description": "相机高度，如胸口高度" },
        "yaw": { "type": "string", "description": "水平角度，如 0° 正面、45°" },
        "framing": { "type": "string", "description": "取景范围，如头到鞋" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "prompt": { "type": "string", "minLength": 8 }
      }
    },
    "pose": {
      "type": "object",
      "required": ["id", "name", "weight", "hands", "gaze", "prompt"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "weight": { "type": "string", "description": "重心与腿" },
        "hands": { "type": "string" },
        "gaze": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "requires": {
          "type": "array",
          "items": { "type": "string", "enum": ["print", "pockets", "hoodie"] }
        },
        "prompt": { "type": "string", "minLength": 8 }
      }
    },
    "recipe": {
      "type": "object",
      "required": ["id", "camera", "pose", "sells", "prompt"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "camera": { "$ref": "#/$defs/id", "description": "必须是 cameras[].id" },
        "pose": { "$ref": "#/$defs/id", "description": "必须是 poses[].id" },
        "sells": { "type": "string", "description": "这张图要卖的结构信息" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "requires": {
          "type": "array",
          "items": { "type": "string", "enum": ["print", "pockets", "hoodie"] }
        },
        "prompt": {
          "type": "string",
          "minLength": 12,
          "description": "贴进裂变模板「本张机位与姿势」的完整段落"
        }
      }
    },
    "pack": {
      "type": "object",
      "required": ["name", "recipes"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "when": { "type": "array", "items": { "type": "string" } },
        "recipes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
