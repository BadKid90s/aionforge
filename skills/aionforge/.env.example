# 复制为 .env 后填写，或直接导出到进程环境。.env 不会进 git。
# 查找顺序：环境变量 > 当前目录 .env > Skill 根目录 .env（即本文件旁边）。
# 分析看图由宿主 Agent 完成，这里只配图片模型。

# ---- 供应商：配了 Key 才会启用 ----
XAI_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=

# custom：任意 OpenAI 兼容网关，Base + Key 都配上后自动优先选中
AIONFORGE_API_BASE=
AIONFORGE_API_KEY=

# 可选覆盖（留空则按已配 Key 自动推断供应商和默认模型）
AIONFORGE_PROVIDER=
AIONFORGE_IMAGE_MODEL=

AIONFORGE_STORAGE_ROOT=~/.aionforge
AIONFORGE_LOG_LEVEL=INFO
AIONFORGE_LOG_CONSOLE=false
AIONFORGE_LOG_FILE=logs/forge.log
