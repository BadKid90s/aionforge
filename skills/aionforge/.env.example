# 复制为 .env 后填写，或直接导出到进程环境。.env 不会进 git。
# 查找顺序：进程环境 > 当前目录 .env > Skill 根目录 .env（即本文件旁边）。
# 分析看图由宿主 Agent 完成，这里只配图片模型。

# ---- 供应商：配了 Key 才会启用；export 与本文件同一变量名 ----
XAI_API_KEY=
XAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
ARK_API_KEY=
ARK_BASE_URL=
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=
QIANFAN_API_KEY=
QIANFAN_BASE_URL=

# 其它 OpenAI 兼容网关（硅基流动、智谱、中转站等）
AIONFORGE_API_BASE=
AIONFORGE_API_KEY=
AIONFORGE_IMAGE_MODEL=

AIONFORGE_STORAGE_ROOT=~/.aionforge
AIONFORGE_LOG_LEVEL=INFO
AIONFORGE_LOG_CONSOLE=false
AIONFORGE_LOG_FILE=logs/forge.log
